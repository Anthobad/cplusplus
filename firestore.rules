rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false; // Trusted Admin SDK operations only; never accept client progress.
      match /{document=**} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }
    }
    match /exams/{examId} {
      allow read: if request.auth != null;
      allow write: if false; // Shared exam publishing requires server IAM/Admin SDK access.
    }
    match /public_content/{document=**} {
      allow read: if true;
    }
  }
}

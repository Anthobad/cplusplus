# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
# Optional server-only model for rubric grading. No keyword fallback if grading is unavailable.
# EXAM_GRADING_MODEL="gemini-3.8-flash"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ISOLATED_RUNNER_ENDPOINT: URL of the containerized sandbox runner service.
# For local development or internal daemon: defaults to http://127.0.0.1:8088.
# For Google Cloud Run isolated runner deployment: set to your Cloud Run URL.
# (e.g. https://cpp-isolated-runner-concentrated-fusion-tdw25-uc.a.run.app)
# If omitted in production, the app safely defaults to the zero-cost Wandbox C++20 provider ($0, no billing).
ISOLATED_RUNNER_ENDPOINT="http://127.0.0.1:8088"

# Optional Wandbox C++ Execution Provider Configuration:
# WANDBOX_COMPILER="gcc-13.2.0"
# WANDBOX_ENDPOINT="https://wandbox.org/api/compile.json"

# CODE_RUNNER_MODE: server-side provider selection, never VITE_*.
# Defaults: vercel-sandbox on Vercel; isolated endpoint or Wandbox on Google production;
# existing local runner in development. No automatic failover after an execution failure.
# CODE_RUNNER_MODE="vercel-sandbox" # alternatives: wandbox, isolated, local (development only)
# Vercel supplies OIDC at runtime. Never copy a development OIDC token into production.
